{
  "name": "vplayer-react",
  "version": "1.6.1",
  "description": "A dependency-free React video player component. One API for MP4, HLS, YouTube, Vimeo and Bilibili, with captions, chapters, playlists, three control skins and analytics callbacks. 14 kB gzipped, TypeScript types included, works in React Server Components.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "react-player",
    "video",
    "video-player",
    "react-video-player",
    "react-video",
    "player",
    "media-player",
    "html5-video",
    "hls",
    "m3u8",
    "youtube",
    "vimeo",
    "bilibili",
    "embed",
    "captions",
    "subtitles",
    "webvtt",
    "chapters",
    "playlist",
    "picture-in-picture",
    "accessible",
    "a11y",
    "typescript",
    "nextjs",
    "react-server-components",
    "lightweight",
    "dependency-free",
    "zero-dependencies",
    "vplayer"
  ],
  "author": "Arda Kaan Aydilek <arda@hovr.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardaydilek/vplayer-react.git"
  },
  "homepage": "https://github.com/ardaydilek/vplayer-react#readme",
  "bugs": {
    "url": "https://github.com/ardaydilek/vplayer-react/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
